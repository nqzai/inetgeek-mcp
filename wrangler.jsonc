{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inetgeek-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],

  // No custom_domain on purpose, for now: this stays reachable only at the
  // workers.dev URL until it's been used for a while, so shipping it never
  // requires a DNS change on the inetgeek.com zone. Add a route here once
  // it's ready to sit at mcp.inetgeek.com.
  "workers_dev": true,

  "observability": { "enabled": true },

  // Usage counting, so "is this server actually used" stops being a guess.
  // One data point per MCP call: the method, and for a handshake the client's
  // self-declared name, or for a tool call the tool's name. No IP address, no
  // argument values, nothing that identifies a person — see the writer in
  // src/index.ts for exactly what each column holds and why.
  //
  // Query it with the Analytics Engine SQL API (needs an API token carrying
  // Account Analytics Read, which the deploy token deliberately does not):
  //
  //   curl https://api.cloudflare.com/client/v4/accounts/<account>/analytics_engine/sql \
  //     -H "Authorization: Bearer <token>" \
  //     -d "SELECT blob1 AS event, blob2 AS who, SUM(_sample_interval) AS n
  //         FROM inetgeek_mcp WHERE timestamp > NOW() - INTERVAL '30' DAY
  //         GROUP BY event, who ORDER BY n DESC"
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "inetgeek_mcp" }],

  // Feedback from agents, written by the send_feedback tool and nothing else.
  // D1 rather than the Analytics Engine dataset above: Analytics Engine
  // samples at volume, and a feedback row must never be sampled away. Schema
  // and what is (not) stored: migrations/0001_feedback.sql. Read and triaged
  // with `npm run feedback` from the site repo (scripts/mcp-feedback.mjs).
  //
  // Running your own copy: create your own database with
  // `wrangler d1 create <name>`, put its id here, and apply the migration with
  // `wrangler d1 migrations apply <name> --remote`. Without the binding the
  // tool still registers and answers that feedback is not being collected.
  "d1_databases": [
    {
      "binding": "FEEDBACK",
      "database_name": "inetgeek-mcp-feedback",
      "database_id": "037a35ea-ea56-49db-9a9d-291b62b2d3f3",
      "migrations_dir": "migrations"
    }
  ],

  // One feedback call per caller every 12 seconds on average. Keyed on the
  // connecting IP, which is used to increment a counter and never stored — the
  // same arrangement the site's DNS tools use, described on /privacy/.
  "ratelimits": [
    { "name": "FEEDBACK_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Daily retention sweep: closed feedback is deleted 90 days after it was
  // closed, and anything at all after 365 days. A retention promise on
  // /privacy/ has to be enforced by something that runs without being asked.
  "triggers": { "crons": ["17 3 * * *"] }
}
